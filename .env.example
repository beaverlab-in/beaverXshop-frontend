# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand (shown in header, footer, metadata)
NEXT_PUBLIC_BRAND_NAME="BeaverLab X Shop"
# Optional: replace the placeholder logo with an image URL (SVG/PNG). Leave empty to use the built-in placeholder mark.
NEXT_PUBLIC_LOGO_URL=

# Data source: "placeholder" = built-in sample catalog + demo account/checkout (no backend needed)
#              "api"         = talk to beaverxshop-backend
NEXT_PUBLIC_DATA_SOURCE=placeholder
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Cloudflare R2 public media hostname (custom domain), used by next/image
NEXT_PUBLIC_MEDIA_HOST=

# Razorpay publishable key id (safe to expose). NEVER put the key secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Shared secret the backend sends to POST /api/revalidate after catalog/settings changes
REVALIDATE_SECRET=change-me
